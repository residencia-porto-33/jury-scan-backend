# Copie este arquivo para ".env" e preencha. NUNCA versione o ".env".

# Ambiente: development | production
APP_ENV=development

# Banco (Postgres). Com "docker compose up", o compose sobrescreve este valor
# para apontar ao container "db". Rodando a API fora do Docker contra o banco do
# compose, use a porta publicada (5432).
DATABASE_URL=postgresql+psycopg://juryscan:juryscan@localhost:5432/juryscan

# Chaves de acesso à API (cabeçalho X-API-Key), separadas por vírgula.
# Em production é obrigatório. Em development, se ficar vazio, a autenticação fica desligada.
API_KEYS=troque-esta-chave

# Origens permitidas no CORS (frontend), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey). A chave fica só no servidor.
GEMINI_API_KEY=
# O Google descontinua modelos com frequência. Liste os modelos da sua chave
# (veja o README, passo 3) e ajuste se receber erro 404.
GEMINI_MODEL=gemini-3.8-flash

# Limites
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
MIN_TEXT_CHARS=100
MAX_TEXT_CHARS=200000
RATE_LIMIT_PER_MINUTE=5

# Guardar o texto integral do CNIS no banco? Por padrão NÃO (contém dados pessoais).
STORE_INPUT_TEXT=false
